{
  "name": "epub-obsidian-reader-v02",
  "version": "0.2.0",
  "private": true,
  "description": "A local EPUB reader that syncs reading notes to an Obsidian vault",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "vite build --watch",
    "test": "node --test",
    "test:runtime": "electron scripts/runtime-smoke.cjs",
    "package": "npm run build && node scripts/package.cjs"
  },
  "dependencies": {
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "vite": "^7.1.9"
  }
}
